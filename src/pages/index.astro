---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { StatsCounter } from '../components/StatsCounter';
import { EmploymentCharts } from '../components/EmploymentCharts';
import { PartnersGrid } from '../components/PartnersGrid';
import { ScrollProgress } from '../components/ScrollProgress';

const cycles = [
  {
    id: 'daw',
    name: 'Desarrollo de Aplicaciones Web',
    abbr: 'DAW',
    description:
      'Diseña y desarrolla aplicaciones web completas, desde el frontend con tecnologías modernas hasta backends robustos y APIs REST.',
    tags: ['HTML5', 'CSS3', 'JavaScript', 'React', 'PHP', 'Java', 'SQL'],
    duration: '2 años · 2000 h',
    level: 'Grado Superior',
    avanza: true,
    color: 'from-indigo-500 to-blue-600',
    glow: 'rgba(99,102,241,0.3)',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>`,
  },
  {
    id: 'dam',
    name: 'Desarrollo de Aplicaciones Multiplataforma',
    abbr: 'DAM',
    description:
      'Crea aplicaciones de escritorio, móviles (Android/iOS) y multiplataforma con acceso a bases de datos y servicios en la nube.',
    tags: ['Java', 'Kotlin', 'Swift', 'Android', 'SQL', 'XML'],
    duration: '2 años · 2000 h',
    level: 'Grado Superior',
    color: 'from-violet-500 to-purple-600',
    glow: 'rgba(139,92,246,0.3)',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18h3" /></svg>`,
  },
  {
    id: 'asir',
    name: 'Administración de Sistemas en Red',
    abbr: 'ASIR',
    description:
      'Administra servidores Linux y Windows, redes corporativas, virtualización y seguridad informática en entornos empresariales.',
    tags: ['Linux', 'Windows Server', 'TCP/IP', 'Docker', 'Cisco', 'Seguridad'],
    duration: '2 años · 2000 h',
    level: 'Grado Superior',
    color: 'from-emerald-500 to-teal-600',
    glow: 'rgba(16,185,129,0.3)',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" /></svg>`,
  },
  {
    id: 'iabd',
    name: 'Inteligencia Artificial y Big Data',
    abbr: 'CE · IA&BD',
    description:
      'Especialización de un año en Machine Learning, redes neuronales, procesamiento de datos masivos y despliegue de modelos en producción.',
    tags: ['Python', 'TensorFlow', 'PyTorch', 'Spark', 'Hadoop', 'SQL', 'MLOps'],
    duration: '1 año · 600 h',
    level: 'Especialización FP',
    badge: 'Alta demanda',
    badgeColor: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
    color: 'from-amber-500 to-orange-600',
    glow: 'rgba(245,158,11,0.3)',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .03 2.692-1.538 2.692H4.336c-1.569 0-2.538-1.692-1.538-2.692L4.2 15.3" /></svg>`,
  },
  {
    id: 'cloud',
    name: 'Recursos y Servicios en la Nube',
    abbr: 'CE · Cloud',
    description:
      'Nuevo ciclo de especialización en arquitectura cloud, DevOps, contenedores y los principales proveedores: AWS, Azure y GCP.',
    tags: ['AWS', 'Azure', 'GCP', 'Kubernetes', 'Terraform', 'CI/CD'],
    duration: '1 año · 600 h',
    level: 'Especialización FP',
    badge: 'NUEVO',
    avanza: true,
    badgeColor: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
    color: 'from-cyan-500 to-sky-600',
    glow: 'rgba(6,182,212,0.3)',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>`,
  },
];
---

<Layout>
  <ScrollProgress client:load />

  <!-- ── Navigation ────────────────────────────────────────── -->
  <header class="fixed top-0 inset-x-0 z-50 px-6 lg:px-8 py-4">
    <nav
      class="max-w-7xl mx-auto flex items-center justify-between glass rounded-2xl px-5 py-3"
      aria-label="Navegación principal"
    >
      <a href="/" class="flex items-center gap-3 group" aria-label="IES Albarregas FP Informática — inicio">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <span class="font-display font-bold text-white text-sm">
          IES Albarregas
          <span class="text-indigo-400"> · FP</span>
        </span>
      </a>

      <ul class="hidden md:flex items-center gap-1 text-sm" role="list">
        {[
          { href: '#ciclos', label: 'Ciclos' },
          { href: '#datos', label: 'Inserción laboral' },
          { href: '#empresas-colaboradoras', label: 'Empresas' },
          { href: '#contacto', label: 'Contacto' },
        ].map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="px-3 py-2 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-white/5 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/formaci%C3%B3n-profesional"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-500 text-white text-sm font-semibold transition-all duration-200 hover:bg-indigo-400 hover:shadow-[0_0_20px_rgba(99,102,241,0.4)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
      >
        Sitio oficial
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </header>

  <main id="main-content">
    <!-- ── Hero ──────────────────────────────────────────────── -->
    <Hero client:load />

    <!-- ── Stats ─────────────────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <StatsCounter client:visible />

    <!-- ── Cycles ─────────────────────────────────────────────── -->
    <section id="ciclos" class="py-20 px-6 lg:px-8" aria-labelledby="cycles-heading">
      <div class="max-w-7xl mx-auto">

        <div class="text-center mb-14">
          <span class="text-xs font-semibold uppercase tracking-widest text-indigo-400">Oferta formativa</span>
          <h2 id="cycles-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-3">
            Elige tu ciclo
          </h2>
          <p class="text-slate-400 mt-4 max-w-2xl mx-auto text-base lg:text-lg">
            Cinco titulaciones oficiales con salida directa al mercado laboral tecnológico.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cycles.map((cycle, i) => (
            <article
              class={`group glass glass-hover rounded-2xl p-6 flex flex-col gap-5 relative overflow-hidden transition-transform duration-300 hover:-translate-y-1 ${i === cycles.length - 1 ? 'sm:col-span-2 lg:col-span-1' : ''}`}
              style={`--glow: ${cycle.glow};`}
              aria-labelledby={`cycle-${cycle.id}-title`}
            >
              <!-- Top gradient bar -->
              <div class={`absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r ${cycle.color}`} aria-hidden="true" />

              <!-- Ambient glow on hover -->
              <div
                class={`absolute top-0 right-0 w-48 h-48 bg-gradient-to-br ${cycle.color} opacity-0 group-hover:opacity-10 rounded-full blur-3xl transition-opacity duration-500 pointer-events-none`}
                aria-hidden="true"
              />

              <div class="flex items-start justify-between gap-3 relative z-10">
                <div class={`w-11 h-11 rounded-xl bg-gradient-to-br ${cycle.color} p-2.5 text-white shrink-0`} aria-hidden="true">
                  <Fragment set:html={cycle.icon} />
                </div>
                {cycle.badge && (
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold border ${cycle.badgeColor}`}>
                    {cycle.badge}
                  </span>
                )}
              </div>

              <div class="relative z-10">
                <p class="text-slate-400 text-xs font-medium uppercase tracking-wider mb-1">{cycle.level}</p>
                <h3 id={`cycle-${cycle.id}-title`} class="font-display text-lg font-bold text-white leading-snug">
                  {cycle.name}
                  <span class="sr-only"> ({cycle.abbr})</span>
                </h3>
                <p class="text-slate-400 text-sm mt-2 leading-relaxed">{cycle.description}</p>
              </div>

              <div class="flex flex-wrap gap-1.5 relative z-10" role="list" aria-label="Tecnologías del ciclo">
                {cycle.tags.map(tag => (
                  <span
                    role="listitem"
                    class="px-2.5 py-1 rounded-md bg-white/5 border border-white/8 text-xs text-slate-400 font-medium"
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-auto flex flex-col gap-2 relative z-10 pt-3 border-t border-white/[0.06]">
                {cycle.avanza && (
                  <span class="inline-flex items-center gap-1.5 self-start px-2.5 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/25 text-[11px] font-semibold text-emerald-400">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H4a2 2 0 01-2-2V5a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2h-1" />
                    </svg>
                    Disponible en modalidad remota · Avanza
                  </span>
                )}
                <div class="flex items-center justify-between">
                <span class="text-xs text-slate-400 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {cycle.duration}
                </span>
                <a
                  href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/oferta-educativa/inform%C3%A1tica-y-comunicaciones"
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-1.5 text-xs font-semibold bg-clip-text text-transparent bg-gradient-to-r ${cycle.color} hover:opacity-80 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded`}
                  aria-label={`Más información sobre ${cycle.name}`}
                >
                  Más info
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="stroke: url(#grad)" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Employment Charts ──────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <EmploymentCharts client:visible />


    <!-- ── Partners Grid ─────────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <PartnersGrid client:visible />

    <!-- ── New Cycle Highlight ────────────────────────────────── -->
    <section class="py-20 px-6 lg:px-8" aria-labelledby="cloud-heading">
      <div class="max-w-7xl mx-auto">
        <div
          class="relative rounded-3xl overflow-hidden border border-cyan-500/20 p-8 lg:p-12"
          style="background: radial-gradient(ellipse 80% 60% at 0% 50%, rgba(6,182,212,0.08) 0%, transparent 70%), rgba(255,255,255,0.02);"
        >
          <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-96 h-96 bg-[radial-gradient(ellipse_at_center,rgba(6,182,212,0.15)_0%,transparent_70%)] pointer-events-none" aria-hidden="true" />

          <div class="grid lg:grid-cols-2 gap-10 items-start relative z-10">

            <!-- Columna izquierda: info general -->
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-5">
                <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-cyan-500/20 border border-cyan-500/30 text-xs font-bold text-cyan-300 uppercase tracking-wider">
                  Nuevo ciclo 2025
                </span>
                <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-400">
                  Especialización FP
                </span>
              </div>

              <h2 id="cloud-heading" class="font-display text-3xl lg:text-4xl font-bold text-white leading-tight">
                Recursos y Servicios <br class="hidden lg:block" />
                <span class="text-cyan-400">en la Nube</span>
              </h2>

              <p class="text-slate-400 mt-5 leading-relaxed">
                Especialización de un año en los servicios cloud más demandados del mercado.
                Administra infraestructuras, bases de datos, redes y despliegues en los principales proveedores.
              </p>

              <!-- Datos del plan -->
              <div class="mt-6 flex flex-wrap gap-3">
                {[
                  { label: 'Duración', value: '1 año', sub: '600 horas lectivas' },
                  { label: 'Turno', value: 'Mañana', sub: 'También a distancia' },
                  { label: 'Plazas', value: '20', sub: 'Ofertadas' },
                ].map(({ label, value, sub }) => (
                  <div class="flex-1 min-w-[90px] rounded-2xl bg-cyan-500/10 border border-cyan-500/20 px-4 py-4 text-center">
                    <p class="text-xs text-cyan-400 font-semibold uppercase tracking-wide mb-1 whitespace-nowrap">{label}</p>
                    <p class="font-display text-2xl font-bold text-white leading-tight">{value}</p>
                    <p class="text-[11px] text-slate-400 mt-0.5 leading-snug">{sub}</p>
                  </div>
                ))}
              </div>

              <ul class="mt-6 space-y-3" role="list">
                {[
                  'Acceso con cualquier FP Superior de Informática',
                  'Disponible en modalidad a distancia',
                ].map(item => (
                  <li class="flex items-start gap-3 text-sm text-slate-400">
                    <svg class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <a
                href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/oferta-educativa/inform%C3%A1tica-y-comunicaciones"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-8 inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-cyan-500 text-white font-semibold text-sm transition-all duration-200 hover:bg-cyan-400 hover:shadow-[0_0_32px_rgba(6,182,212,0.4)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
              >
                Solicitar información
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>

            <!-- Columna derecha: módulos del plan de estudios -->
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">Plan de estudios · Módulos</p>
              <ol class="space-y-3" role="list">
                {[
                  'Fundamentos y configuración inicial de servicios en la nube',
                  'Administración de recursos de computación en la nube',
                  'Administración de bases de datos y almacenamiento en la nube',
                  'Administración de redes en la nube',
                  'Despliegue de servicios administrados en la nube',
                ].map((mod, i) => (
                  <li class="flex items-start gap-4 glass rounded-xl px-4 py-3.5">
                    <span class="shrink-0 w-6 h-6 rounded-full bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center text-[11px] font-bold text-cyan-400 mt-0.5">
                      {i + 1}
                    </span>
                    <span class="text-sm text-slate-300 leading-snug">{mod}</span>
                  </li>
                ))}
              </ol>

              <div class="mt-5 flex items-center gap-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 px-4 py-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H4a2 2 0 01-2-2V5a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2h-1" />
                </svg>
                <p class="text-sm font-semibold text-emerald-300">¡También disponible en modalidad a distancia!</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── CTA ──────────────────────────────────────────────── -->
    <section id="contacto" class="py-24 px-6 lg:px-8" aria-labelledby="cta-heading">
      <div class="max-w-4xl mx-auto text-center">

        <div
          class="relative rounded-3xl overflow-hidden p-10 lg:p-16"
          style="background: radial-gradient(ellipse 80% 80% at 50% 100%, rgba(99,102,241,0.18) 0%, transparent 70%), rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.07);"
        >
          <!-- Top glow -->
          <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.3)_0%,transparent_70%)] pointer-events-none" aria-hidden="true" />

          <div class="relative z-10">
            <span class="text-xs font-semibold uppercase tracking-widest text-indigo-400">
              ¿Listo para dar el salto?
            </span>

            <h2 id="cta-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-4 leading-tight">
              Tu carrera en tecnología <br class="hidden sm:block" />
              <span class="gradient-text">empieza aquí</span>
            </h2>

            <p class="text-slate-400 mt-5 max-w-xl mx-auto text-base lg:text-lg leading-relaxed">
              Únete a más de 100 egresados que ya trabajan en empresas como NTT Data, Stemdo, Viewnext, Ayesa y muchas más.
              Contacta con nosotros para más información sobre matriculación y admisión.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
              <a
                href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/formaci%C3%B3n-profesional"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-indigo-500 text-white font-bold text-base transition-all duration-200 hover:bg-indigo-400 hover:shadow-[0_0_40px_rgba(99,102,241,0.5)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
              >
                Visitar el centro
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a
                href="mailto:ies.albarregas@edu.juntaex.es"
