---
import Layout from '../layouts/Layout.astro';
import { Hero } from '../components/Hero';
import { StatsCounter } from '../components/StatsCounter';
import { EmploymentCharts } from '../components/EmploymentCharts';
import { PartnersGrid } from '../components/PartnersGrid';
import { ScrollProgress } from '../components/ScrollProgress';

---

<Layout>
  <ScrollProgress client:load />

  <!-- ── Navigation ────────────────────────────────────────── -->
  <header class="fixed top-0 inset-x-0 z-50 px-6 lg:px-8 py-4">
    <nav
      class="max-w-7xl mx-auto flex items-center justify-between glass rounded-2xl px-5 py-3 shadow-[0_2px_16px_rgba(0,0,0,0.07)]"
      aria-label="Navegación principal"
    >
      <a href="/" class="flex items-center gap-3 group" aria-label="IES Albarregas · FP — inicio">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <span class="font-display font-bold text-slate-900 text-sm">
          IES Albarregas
          <span class="text-blue-600"> · FP</span>
        </span>
      </a>

      <ul class="hidden md:flex items-center gap-1 text-sm" role="list">
        {[
          { href: '#datos', label: 'Inserción laboral' },
          { href: '#empresas-colaboradoras', label: 'Empresas' },
          { href: '#contacto', label: 'Contacto' },
        ].map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/formaci%C3%B3n-profesional"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 text-white text-sm font-semibold transition-all duration-200 hover:bg-blue-500 hover:shadow-[0_4px_12px_rgba(37,99,235,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      >
        Volver
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </nav>
  </header>

  <main id="main-content">
    <!-- ── Hero ──────────────────────────────────────────────── -->
    <Hero client:load />

    <!-- ── Stats ─────────────────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <StatsCounter client:visible />

    <!-- ── Employment Charts ──────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <EmploymentCharts client:visible />


    <!-- ── Partners Grid ─────────────────────────────────────── -->
    <div class="section-divider" role="separator" />
    <PartnersGrid client:visible />

    <!-- ── CTA ──────────────────────────────────────────────── -->
    <section id="contacto" class="py-24 px-6 lg:px-8" aria-labelledby="cta-heading">
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="relative rounded-3xl overflow-hidden p-10 lg:p-16"
          style="background: radial-gradient(ellipse 80% 80% at 50% 100%, rgba(37,99,235,0.07) 0%, transparent 70%), #f8fafc; border: 1px solid #e2e8f0;"
        >
          <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.12)_0%,transparent_70%)] pointer-events-none" aria-hidden="true" />

          <div class="relative z-10">
            <span class="text-xs font-semibold uppercase tracking-widest text-blue-600">
              ¿Listo para dar el salto?
            </span>

            <h2 id="cta-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mt-4 leading-tight">
              Tu carrera en tecnología <br class="hidden sm:block" />
              <span class="gradient-text">empieza aquí</span>
            </h2>

            <p class="text-slate-500 mt-5 max-w-xl mx-auto text-base lg:text-lg leading-relaxed">
              Únete a más de 100 egresados que ya trabajan en empresas como NTT Data, Stemdo, Viewnext, Ayesa y muchas más.
              Contacta con nosotros para más información sobre matriculación y admisión.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
              <a
                href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/formaci%C3%B3n-profesional"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-blue-600 text-white font-bold text-base transition-all duration-200 hover:bg-blue-500 hover:shadow-[0_8px_24px_rgba(37,99,235,0.4)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              >
                Visitar el centro
                <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a
                href="mailto:ies.albarregas@edu.juntaex.es"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-slate-300 bg-white text-slate-700 font-bold text-base transition-all duration-200 hover:bg-slate-50 hover:border-slate-400 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Enviar email
              </a>
              <a
                href="tel:+34924009856"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-slate-300 bg-white text-slate-700 font-bold text-base transition-all duration-200 hover:bg-slate-50 hover:border-slate-400 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                924 00 98 56
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ── Footer ──────────────────────────────────────────────── -->
  <footer class="border-t border-slate-200 bg-slate-50 py-12 px-6 lg:px-8" role="contentinfo">
    <div class="max-w-7xl mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 mb-12">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <span class="font-display font-bold text-slate-900">IES Albarregas <span class="text-blue-600">· FP</span></span>
          </div>
          <p class="text-slate-500 text-sm leading-relaxed max-w-xs">
            Formación Profesional de Informática en Mérida, Extremadura. Formando profesionales TIC desde hace más de 20 años.
          </p>
        </div>

        <div>
          <h3 class="text-slate-700 font-semibold text-sm mb-4">Contacto</h3>
          <ul class="space-y-2 text-slate-500 text-sm" role="list">
            <li>Calle Almendralejo s/n</li>
            <li>06800 Mérida, Badajoz</li>
            <li>
              <a href="mailto:ies.albarregas@edu.juntaex.es" class="hover:text-slate-700 transition-colors">
                ies.albarregas@edu.juntaex.es
              </a>
            </li>
            <li>
              <a
                href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/oferta-educativa/inform%C3%A1tica-y-comunicaciones"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-slate-700 transition-colors"
              >
                iesalbarregas.es ↗
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="section-divider mb-8" role="separator" />

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>
          &copy; {new Date().getFullYear()} IES Albarregas · Junta de Extremadura ·
          <a
            href="https://sites.google.com/iesalbarregas.es/fpeneliesalbarregas/oferta-educativa/inform%C3%A1tica-y-comunicaciones"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-slate-700 transition-colors"
          >
            Consejería de Educación
          </a>
        </p>
        <p>Datos basados en encuesta a más de 100 egresados (2023/24 · 2024/25)</p>
      </div>
    </div>
  </footer>
</Layout>
