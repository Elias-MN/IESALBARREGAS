---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
}

const {
  title = 'FP Informática | IES Albarregas — Ciclos TIC en Mérida, Extremadura',
  description = 'Estudia DAW, DAM, ASIR, Inteligencia Artificial y Big Data, o Cloud en el IES Albarregas de Mérida. Alta inserción laboral: el 87 % encuentra empleo en el sector en menos de 6 meses.',
  image = '/og-image.png',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = 'https://fp.iesalbarregas.es';
const canonicalURL = new URL(canonicalPath, siteUrl).href;
const imageURL = new URL(image, siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'IES Albarregas',
  alternateName: 'FP Informática IES Albarregas',
  description,
  url: siteUrl,
  logo: `${siteUrl}/logo.svg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle Almendralejo s/n',
    addressLocality: 'Mérida',
    addressRegion: 'Extremadura',
    postalCode: '06800',
    addressCountry: 'ES',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ciclos Formativos de Informática y Comunicaciones',
    itemListElement: [
      {
        '@type': 'Course',
        name: 'Desarrollo de Aplicaciones Web (DAW)',
        description: 'FP de Grado Superior — Desarrollo frontend y backend de aplicaciones web.',
        educationalLevel: 'Formación Profesional de Grado Superior',
        timeRequired: 'P2Y',
        provider: { '@type': 'EducationalOrganization', name: 'IES Albarregas' },
      },
      {
        '@type': 'Course',
        name: 'Desarrollo de Aplicaciones Multiplataforma (DAM)',
        description: 'FP de Grado Superior — Aplicaciones de escritorio, móvil y multiplataforma.',
        educationalLevel: 'Formación Profesional de Grado Superior',
        timeRequired: 'P2Y',
        provider: { '@type': 'EducationalOrganization', name: 'IES Albarregas' },
      },
      {
        '@type': 'Course',
        name: 'Administración de Sistemas Informáticos en Red (ASIR)',
        description: 'FP de Grado Superior — Administración de servidores, redes y ciberseguridad.',
        educationalLevel: 'Formación Profesional de Grado Superior',
        timeRequired: 'P2Y',
        provider: { '@type': 'EducationalOrganization', name: 'IES Albarregas' },
      },
      {
        '@type': 'Course',
        name: 'Especialización en Inteligencia Artificial y Big Data (CE-IABD)',
        description: 'Curso de Especialización — Machine Learning, Deep Learning y análisis de datos masivos.',
        educationalLevel: 'Curso de Especialización (FP)',
        timeRequired: 'P1Y',
        provider: { '@type': 'EducationalOrganization', name: 'IES Albarregas' },
      },
      {
        '@type': 'Course',
        name: 'Especialización en Recursos y Servicios en la Nube (CE-Cloud)',
        description: 'Curso de Especialización — AWS, Azure, GCP y arquitectura cloud.',
        educationalLevel: 'Curso de Especialización (FP)',
        timeRequired: 'P1Y',
        provider: { '@type': 'EducationalOrganization', name: 'IES Albarregas' },
      },
    ],
  },
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="keywords"
      content="FP Informática Mérida, DAW Extremadura, DAM Badajoz, ASIR, Inteligencia Artificial Big Data, ciclos formativos informática, ciclo especialización cloud, inserción laboral FP"
    />
    <meta name="author" content="IES Albarregas" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="IES Albarregas FP Informática" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Fonts — preconnect first for perf -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800&display=swap"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-[#030712] text-slate-100 font-sans antialiased">
    <slot />
  </body>
</html>
